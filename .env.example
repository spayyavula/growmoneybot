# Copy to .env for local dev, and add the same keys in
# Netlify -> Site configuration -> Environment variables

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/growmoneybot?retryWrites=true&w=majority

# Long random string for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

CORS_ORIGIN=https://growmoneybot.com

# US stock data (free account at https://alpaca.markets -> API keys)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# "iex" works on the free plan; "sip" needs a paid data plan
ALPACA_FEED=iex

# Optional: crypto data base URL (default https://api.binance.us)
# CRYPTO_API_BASE=https://api.binance.us

# Marketplace admins (comma-separated emails). Admins review expert applications
# and can remove algorithms from the marketplace.
ADMIN_EMAILS=
